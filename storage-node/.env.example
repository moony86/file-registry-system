# Stable node identity. "auto" creates data/node_identity.json on first run.
NODE_ID=auto

# "auto" advertises the detected local IP. Use a fixed IP only if needed.
NODE_HOST=auto
NODE_PORT=5001

# Master fallback order. The node remembers the working master at runtime.
MASTER_URLS=http://192.168.1.14:5000,http://localhost:5000
FSYS_NODE_TOKEN=dev-token

SHARED_SPACE_ENABLED=true
SHARED_SPACE_DIR=./shared_space
SHARED_SPACE_LIMIT_BYTES=21474836480

THUMBNAILS_DIR=./thumbnails
DATA_DIR=./data

# Comma-separated folders that Browse Local Library can expose.
LOCAL_LIBRARY_DIRS=

FSYS_CORS_ORIGINS=http://192.168.1.14:5000,http://localhost:5000,http://127.0.0.1:5000
